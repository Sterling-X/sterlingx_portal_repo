# Local dev: leave unset and run `gcloud auth application-default login` instead.
# Deployed (Cloud Run): the service account is normally attached to the Cloud
# Run service itself rather than passed as a key file — only set this if
# using a downloaded key locally.
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Auth0 (see docs/auth0-app-setup.md) ---
# This app registers its own Application in the shared SterlingX Auth0
# tenant -- do not reuse another app's AUTH0_CLIENT_ID/AUTH0_CLIENT_SECRET.

# Required. Generate with: openssl rand -hex 32
AUTH0_SECRET=

# Required. Local dev: http://localhost:3000 — Deployed: the Cloud Run URL.
AUTH0_BASE_URL=

# The shared SterlingX Auth0 tenant -- see AI-Projects docs/auth0-setup.md.
AUTH0_ISSUER_BASE_URL=https://dev-ydfs61vssild4nxt.us.auth0.com

# From this app's own Auth0 Application (docs/auth0-app-setup.md step 1).
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# This app's Auth0 API audience -- also used to request the Management API
# token in src/server/auth0-mgmt.ts (that call hardcodes the /api/v2/
# audience, unrelated to this value).
AUTH0_AUDIENCE=

# Bearer secret the Cloud Scheduler job sends so the daily checkup can run
# without a browser session. Generate any long random string.
CHECKUP_CRON_SECRET=
